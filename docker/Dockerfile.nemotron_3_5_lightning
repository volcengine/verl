# NGC-based environment for the Nemotron 3.5 Lightning SFT and GRPO recipes.
# The base image supplies CUDA and the system toolchain; Python dependencies
# come from the repository's committed uv.lock in an isolated project venv.
# The venv intentionally shadows NGC's bundled Python packages, including Torch.

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:26.06-py3
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG VERL_COMMIT=unknown
ARG MAX_JOBS=16
ARG TORCH_CUDA_ARCH_LIST="9.0;10.0"

LABEL org.opencontainers.image.source="https://github.com/verl-project/verl" \
      org.opencontainers.image.revision="${VERL_COMMIT}" \
      org.opencontainers.image.description="verl Nemotron 3.5 Lightning SFT and GRPO environment"

# NGC images set /etc/pip/constraint.txt globally. Native package builds in the
# locked environment must not inherit constraints for the base image's Python
# stack, which is intentionally isolated from the project venv.
RUN touch /opt/verl-empty-constraints.txt

ENV MAX_JOBS=${MAX_JOBS} \
    NO_VCS_VERSION=1 \
    PIP_CONSTRAINT=/opt/verl-empty-constraints.txt \
    PIP_NO_CACHE_DIR=1 \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/verl/.venv \
    UV_PYTHON_DOWNLOADS=never \
    VIRTUAL_ENV=/workspace/verl/.venv \
    VLLM_TARGET_DEVICE=cuda \
    PATH="/workspace/verl/.venv/bin:${PATH}"

RUN test "${VERL_COMMIT}" != unknown

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ffmpeg \
        git \
        libibverbs-dev \
        libnuma-dev \
        librdmacm-dev \
        ninja-build \
        numactl && \
    rm -rf /var/lib/apt/lists/*

# Keep the installer version aligned with the repository's general CUDA image.
COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /uvx /bin/

WORKDIR /workspace/verl

# The build-context ignore rules keep host state and unrelated repository files
# out of the image while retaining all inputs needed to install verl.
COPY pyproject.toml uv.lock setup.py README.md LICENSE Notice.txt ./
COPY verl ./verl
COPY examples ./examples

# Install the exact combined training/rollout stack from uv.lock. In particular,
# Bridge and the CUDA extensions come from the configured wheelhouse, vLLM comes
# from its upstream wheel, and only the lock-pinned Megatron-Core source package
# is built by uv. Bridge's published dependency metadata intentionally conflicts
# with the project lock and is overridden by pyproject.toml, so validate the
# installed runtime directly instead of using `uv pip check`.
RUN uv sync --frozen --no-dev --extra megatron --extra vllm && \
    CAUSAL_CONV1D_FORCE_BUILD=TRUE uv pip install \
        --no-binary :all: --no-build-isolation --no-deps \
        "causal-conv1d==1.6.2.post1" && \
    MAMBA_FORCE_BUILD=TRUE uv pip install \
        --no-binary :all: --no-build-isolation --no-deps \
        "mamba-ssm==2.3.2.post1" && \
    python -c 'from importlib.metadata import version; from megatron.core.ssm import mamba_mixer as mm; expected = {"torch": "2.13.0+cu130", "transformer-engine": "2.16.1", "megatron-bridge": "0.6.2", "megatron-core": "0.19.2", "vllm": "0.29.0", "transformers": "5.12.1", "causal-conv1d": "1.6.2.post1", "mamba-ssm": "2.3.2.post1"}; actual = {name: version(name) for name in expected}; assert actual == expected, (actual, expected); assert mm.HAVE_MAMBA_SSM; assert mm.causal_conv1d_fn is not None; print(actual)' && \
    uv cache clean

CMD ["bash"]
